---
import { nav, site } from '../data/site';

const currentPath = Astro.url.pathname;
const norm = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const cur = norm(currentPath);
const isActive = (href: string) => {
  const target = norm(href);
  if (target === '/') return cur === '/';
  return cur === target || cur.startsWith(target);
};
---

<header class="header">
  <div class="container header__inner">
    <a href="/" class="logo" aria-label={`${site.brand} — home`}>
      <span class="logo__mark">HY</span>
      <span class="logo__text">
        <strong>{site.brand}</strong>
        <small>filter manufacturer &amp; exporter</small>
      </span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <label for="nav-toggle" class="nav-toggle-btn" aria-label="Toggle navigation">
      <span class="nav-toggle-btn__bar"></span>
      <span class="nav-toggle-btn__bar"></span>
      <span class="nav-toggle-btn__bar"></span>
    </label>

    <nav class="nav" id="primary-nav" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class={isActive(item.href) ? 'nav__link is-active' : 'nav__link'}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a class="btn btn--primary nav__cta" href="/contact/">Get a Quote</a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--navy-800);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.04) inset;
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: var(--header-h);
  }

  .logo { display: flex; align-items: center; gap: 0.65rem; color: #fff; }
  .logo:hover { color: #fff; }
  .logo__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 9px;
    background: linear-gradient(135deg, var(--orange-500), var(--orange-600));
    color: #fff;
    font-weight: 800;
    letter-spacing: 0.5px;
    box-shadow: 0 2px 8px rgba(232, 98, 44, 0.35);
  }
  .logo__text { display: flex; flex-direction: column; line-height: 1.12; }
  .logo__text strong { font-size: 1.12rem; letter-spacing: 0.2px; }
  .logo__text small { font-size: 0.7rem; color: var(--navy-100); }

  .nav { display: flex; align-items: center; gap: 0.2rem; }
  .nav__link {
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    color: var(--navy-100);
    font-weight: 500;
    font-size: 0.94rem;
    transition: color var(--t-fast) var(--ease), background var(--t-fast) var(--ease);
  }
  .nav__link:hover { color: #fff; background: rgba(255, 255, 255, 0.08); }
  .nav__link.is-active { color: var(--orange-400); font-weight: 700; }
  .nav__cta { margin-left: 0.75rem; }

  .nav-toggle { display: none; }
  .nav-toggle-btn { display: none; }

  @media (max-width: 900px) {
    .header__inner {
      flex-wrap: wrap;
      height: auto;
      min-height: var(--header-h);
      padding: 0.7rem var(--sp-5);
    }
    .nav-toggle-btn {
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 5px;
      width: 44px;
      height: 44px;
      cursor: pointer;
      border-radius: 8px;
    }
    .nav-toggle-btn:hover { background: rgba(255, 255, 255, 0.08); }
    .nav-toggle-btn__bar {
      display: block;
      width: 24px;
      height: 2px;
      background: #fff;
      border-radius: 2px;
      transition: transform var(--t-fast) var(--ease), opacity var(--t-fast) var(--ease);
    }
    .nav {
      display: none;
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      padding: 0.5rem 0 1rem;
      gap: 0.2rem;
    }
    .nav__link { padding: 0.7rem 0.75rem; font-size: 1rem; }
    .nav__cta { margin: 0.6rem 0 0; justify-content: center; }

    .nav-toggle:checked ~ .nav { display: flex; }
    .nav-toggle:checked ~ .nav-toggle-btn .nav-toggle-btn__bar:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .nav-toggle:checked ~ .nav-toggle-btn .nav-toggle-btn__bar:nth-child(2) { opacity: 0; }
    .nav-toggle:checked ~ .nav-toggle-btn .nav-toggle-btn__bar:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { brandCompanyRelationship } from '../data/company';

// Direct-contact page (no server-side form on this static site).
// Product-page "Request a quote" links pass ?product=MODEL&url=… to pre-fill a mailto.
const productParam = Astro.url.searchParams.get('product') ?? '';
const urlParam = Astro.url.searchParams.get('url') ?? '';
const hasProduct = Boolean(productParam);

const mailtoSubject = hasProduct ? `RFQ ${productParam}` : 'Filter inquiry';
const mailtoBody = [
  hasProduct ? `Model: ${productParam}` : '',
  hasProduct && urlParam ? `Product URL: ${urlParam}` : '',
  '',
  'OE / cross-reference number:',
  'Target quantity:',
  'Destination market:',
  'Packaging / private-label requirements:',
].filter(Boolean).join('\n');
const mailtoHref = `mailto:${site.email}?subject=${encodeURIComponent(mailtoSubject)}&body=${encodeURIComponent(mailtoBody)}`;
---

<BaseLayout title="Contact" description="Contact Huiying Automotive Parts by email, WhatsApp, phone or WeChat for filter quotations.">
  <section class="page-hero">
    <div class="container"><h1>Contact Us</h1><p>Tell us your OE number or application and we will match the right filter.</p></div>
  </section>

  <section class="section">
    <div class="container contact">
      <div class="contact__info">
        <h2>{site.companyName}</h2>
        <p>All employees of the company sincerely welcome guests from all over the world and merchants from all over the world to visit and negotiate business.</p>
        <p class="muted small">{brandCompanyRelationship.text}</p>
        <ul class="contact__list">
          <li><strong>Email:</strong> <a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><strong>Phone | WeChat:</strong> <a href={`tel:${site.phoneHref}`}>{site.phone}</a></li>
          <li><strong>Address:</strong> {site.address}</li>
        </ul>

        <div class="contact__actions">
          <a class="wa-btn" href={site.whatsappLink} target="_blank" rel="nofollow noopener">💬 Chat on WhatsApp Now</a>
          <a class="btn btn--primary" href={mailtoHref}>Email us your inquiry</a>
        </div>
      </div>

      <div class="contact__tips card">
        <h2>For a faster quote, please include</h2>
        <ul class="tick-list">
          <li><strong>OE / cross-reference number</strong> or vehicle application — we match the exact part, not a guess</li>
          <li><strong>Target quantity</strong> and <strong>destination market</strong></li>
          <li><strong>Packaging or private-label requirements</strong> — neutral, custom or your own brand</li>
        </ul>
        <p class="muted small">
          Our sales team replies within one working day. To quote precisely, email us the above details or
          message us on WhatsApp — there is no need to register or create an account.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: start; }
  .contact__list { list-style: none; margin: 1.25rem 0; padding: 0; }
  .contact__list li { margin-bottom: 0.6rem; }
  .contact__actions { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; margin-top: 1.5rem; }
  .contact__tips { padding: var(--sp-6); }
  .contact__tips h2 { color: var(--navy-800); font-size: 1.15rem; }
  .tick-list { list-style: none; margin: 0; padding: 0; font-size: 0.95rem; }
  .tick-list li { padding-left: 1.5rem; position: relative; margin-bottom: 0.7rem; }
  .tick-list li::before { content: "✓"; position: absolute; left: 0; color: var(--orange-500); font-weight: 700; }
  @media (max-width: 820px) { .contact { grid-template-columns: 1fr; } }
</style>

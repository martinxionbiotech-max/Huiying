---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title="Contact" description="Contact us for filter inquiries.">
  <section class="page-hero">
    <div class="container"><h1>Contact Us</h1><p>Tell us your OE number or application and we will match the right filter.</p></div>
  </section>

  <section class="section">
    <div class="container contact">
      <div class="contact__info">
        <h2>{site.companyName}</h2>
        <p>All employees of the company sincerely welcome guests from all over the world and merchants from all over the world to visit and negotiate business.</p>
        <ul class="contact__list">
          <li><strong>Phone | WeChat:</strong> <a href={`tel:${site.phoneHref}`}>{site.phone}</a></li>
          <li><strong>WhatsApp:</strong> <a href={site.whatsappLink} target="_blank" rel="nofollow noopener">{site.whatsapp}</a></li>
          <li><strong>Email:</strong> <a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><strong>Address:</strong> {site.address}</li>
        </ul>
        <a class="wa-btn" href={site.whatsappLink} target="_blank" rel="nofollow noopener">💬 Chat on WhatsApp Now</a>

        <div class="contact__tips">
          <h3>For a faster quote, please include</h3>
          <ul class="tick-list">
            <li>OE / cross-reference number or vehicle application</li>
            <li>Target quantity and destination market</li>
            <li>Any private-label or packaging requirements</li>
          </ul>
        </div>
      </div>

      <div class="contact__form card">
        <h2>Leave a Message</h2>
        <p class="muted small">We will contact you within one working day. Please pay attention to your email.</p>
        <form action={`mailto:${site.email}`} method="post" enctype="text/plain">
          <label>Name<input type="text" name="name" required /></label>
          <label>Email<input type="email" name="email" required /></label>
          <label>Phone / WhatsApp<input type="text" name="phone" /></label>
          <label>Message<textarea name="message" rows="4" required></textarea></label>
          <button class="btn btn--primary" type="submit">Submit</button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: start; }
  .contact__list { list-style: none; margin: 1.25rem 0; padding: 0; }
  .contact__list li { margin-bottom: 0.6rem; }
  .contact__tips { margin-top: 2rem; padding: var(--sp-5); background: var(--bg-soft); border-radius: var(--radius); }
  .contact__tips h3 { color: var(--navy-800); font-size: 1rem; }
  .tick-list { list-style: none; margin: 0; padding: 0; font-size: 0.92rem; }
  .tick-list li { padding-left: 1.5rem; position: relative; margin-bottom: 0.5rem; }
  .tick-list li::before { content: "✓"; position: absolute; left: 0; color: var(--orange-500); font-weight: 700; }
  .contact__form form { display: grid; gap: 1rem; margin-top: 1rem; }
  .contact__form label { display: grid; gap: 0.3rem; font-weight: 600; font-size: 0.9rem; }
  .contact__form input, .contact__form textarea {
    padding: 0.65rem 0.8rem; border: 1px solid var(--line); border-radius: var(--radius-sm);
    font: inherit; font-weight: 400;
  }
  .contact__form input:focus, .contact__form textarea:focus { outline: 2px solid var(--orange-500); outline-offset: 1px; border-color: transparent; }
  @media (max-width: 820px) { .contact { grid-template-columns: 1fr; } }
</style>

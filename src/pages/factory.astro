---
import BaseLayout from '../layouts/BaseLayout.astro';
import { factoryInfo, industryBackground, site } from '../data/company';
---

<BaseLayout title="Factory" description="How to reach our factory.">
  <section class="page-hero">
    <div class="container"><h1>Factory</h1><p>{factoryInfo.heading}</p></div>
  </section>

  <section class="section">
    <div class="container factory">
      <div class="factory__text">
        <h2>{factoryInfo.heading}</h2>
        <p>{factoryInfo.intro}</p>
        <ol>
          {factoryInfo.pickupPoints.map((p) => <li>{p}</li>)}
        </ol>
        <p class="muted small">Pick-up from any of the above locations is arranged free of charge for visiting customers.</p>
      </div>
      <img src={factoryInfo.image} alt="Factory / technical support" width="560" height="420" loading="lazy" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Factory Gallery</h2>
        <p class="muted">Production, quality control and warehousing at our Qinghe facility.</p>
      </div>
      <div class="grid grid--4">
        <img src="/images/4ccdbf70-687a-410d-b596-55757094e37f.jpg" alt="Huiying factory — production area" loading="lazy" />
        <img src="/images/961d7908-60f5-4a42-8caa-b67c5c55ce11.png" alt="Huiying factory — manufacturing line" loading="lazy" />
        <img src="/images/b1412b80-d35c-4e8c-abfb-917770ed4190.png" alt="Huiying factory — workshop" loading="lazy" />
        <img src="/images/b27a61f1-1ae2-45bc-9dfc-310bd3f67f3d.png" alt="Huiying factory — production equipment" loading="lazy" />
        <img src="/images/b5a75dda-4946-4659-a382-773c64e0055a.jpg" alt="Huiying factory — quality control" loading="lazy" />
        <img src="/images/cdb5ad87-ffa7-4c86-996d-da097a190a17.jpg" alt="Huiying factory — warehousing" loading="lazy" />
        <img src="/images/de9d5cc3-72d8-4aec-aaf5-1b78f4ca3e3c.png" alt="Huiying factory — technical support" loading="lazy" />
        <img src="/images/f160b99a-513c-4af0-8b6b-7c10b433130d.jpg" alt="Huiying factory — packaging and dispatch" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <h2>{industryBackground.heading}</h2>
      </div>
      <div class="factory-region">
        <p>{industryBackground.paragraphs[1]}</p>
        <p>{industryBackground.paragraphs[2]}</p>
        <ul class="tick-list">
          {industryBackground.points.map((p) => <li>{p}</li>)}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .factory { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 3rem; align-items: center; }
  .factory ol { padding-left: 1.4rem; font-size: 1.05rem; }
  .factory ol li { margin-bottom: 0.5rem; }
  .factory img { border-radius: var(--radius); box-shadow: var(--shadow-md); }
  .factory-region { max-width: 800px; }
  .tick-list { list-style: none; margin: 1rem 0 0; padding: 0; }
  .tick-list li { padding-left: 1.6rem; position: relative; margin-bottom: 0.6rem; }
  .tick-list li::before { content: "✓"; position: absolute; left: 0; color: var(--orange-500); font-weight: 700; }
  @media (max-width: 820px) { .factory { grid-template-columns: 1fr; } }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { factoryInfo, companyDisclosure, industryBackground, productionProcess, qualitySystem, equipmentCategories, oemDeliveryProcess } from '../data/company';
---

<BaseLayout title="Factory" description="How to reach our factory.">
  <section class="page-hero">
    <div class="container"><h1>Factory</h1><p>{factoryInfo.heading}</p></div>
  </section>

  <section class="section">
    <div class="container factory">
      <div class="factory__text">
        <h2>{factoryInfo.heading}</h2>
        <p>{factoryInfo.intro}</p>
        <ol>
          {factoryInfo.pickupPoints.map((p) => <li>{p}</li>)}
        </ol>
        <p class="muted small">Pick-up from any of the above locations is arranged free of charge for visiting customers.</p>
      </div>
      <img src={factoryInfo.image} alt="Huiying filter factory workshop panorama" width="560" height="420" loading="lazy" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Factory Gallery</h2>
        <p class="muted">Production, quality control and warehousing at our Qinghe facility.</p>
      </div>
      <div class="grid grid--4">
        <img src="/images/factory-ai/factory-01-1600x1200.webp" alt="Huiying factory — workshop panorama" width="1600" height="1200" loading="lazy" />
        <img src="/images/factory-ai/factory-02-1600x1200.webp" alt="Huiying factory — filter production line" width="1600" height="1200" loading="lazy" />
        <img src="/images/factory-ai/factory-03-1600x1200.webp" alt="Huiying factory — filter paper pleating machine" width="1600" height="1200" loading="lazy" />
        <img src="/images/factory-ai/factory-04-1600x1200.webp" alt="Huiying factory — quality inspection bench" width="1600" height="1200" loading="lazy" />
        <img src="/images/factory-ai/factory-05-1600x1200.webp" alt="Huiying factory — finished filter element" width="1600" height="1200" loading="lazy" />
        <img src="/images/factory-ai/factory-06-1600x1200.webp" alt="Huiying factory — warehousing" width="1600" height="1200" loading="lazy" />
        <img src="/images/factory-ai/factory-07-1600x1200.webp" alt="Huiying factory — packaging and dispatch" width="1600" height="1200" loading="lazy" />
        <img src="/images/factory-ai/factory-08-1600x1200.webp" alt="Huiying factory — laboratory testing" width="1600" height="1200" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>{productionProcess.heading}</h2>
        <p class="lede">{productionProcess.intro}</p>
      </div>
      <ol class="process-list">
        {productionProcess.steps.map((s) => (
          <li>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <h2>{qualitySystem.heading}</h2>
        <p class="lede">{qualitySystem.intro}</p>
      </div>
      <div class="grid grid--4">
        {qualitySystem.gates.map((g) => (
          <div class="qc-gate">
            <span class="qc-gate__code">{g.code}</span>
            <h3>{g.name}</h3>
            <p class="muted">{g.text}</p>
          </div>
        ))}
      </div>
      <p class="muted small mt-2">{qualitySystem.aqlNote}</p>
    </div>
  </section>

  <section class="section">
    <div class="container two-col">
      <div>
        <div class="section-head">
          <h2>{equipmentCategories.heading}</h2>
          <p class="lede">{equipmentCategories.intro}</p>
        </div>
      </div>
      <ul class="tick-list">
        {equipmentCategories.items.map((i) => <li>{i}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <h2>{oemDeliveryProcess.heading}</h2>
      </div>
      <ol class="process-list">
        {oemDeliveryProcess.steps.map((s) => (
          <li>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <h2>{companyDisclosure.heading}</h2>
      </div>
      <div class="factory-disclosure">
        <dl class="disclosure__list">
          {companyDisclosure.items.map((i) => (
            <div class="disclosure__row">
              <dt>{i.label}</dt>
              <dd>{i.value}</dd>
            </div>
          ))}
        </dl>
        <p class="muted small">{companyDisclosure.sourceNote}</p>
        <p class="muted small">
          <a href={companyDisclosure.baikeUrl} target="_blank" rel="noopener">{companyDisclosure.baikeLabel}</a>
          — {companyDisclosure.baikeNote}
        </p>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <h2>{industryBackground.heading}</h2>
      </div>
      <div class="factory-region">
        <p>{industryBackground.paragraphs[1]}</p>
        <p>{industryBackground.paragraphs[2]}</p>
        <ul class="tick-list">
          {industryBackground.points.map((p) => <li>{p}</li>)}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .factory { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 3rem; align-items: center; }
  .factory ol { padding-left: 1.4rem; font-size: 1.05rem; }
  .factory ol li { margin-bottom: 0.5rem; }
  .factory img { border-radius: var(--radius); box-shadow: var(--shadow-md); }
  .factory-region { max-width: 800px; }
  .factory-disclosure { max-width: 860px; }
  .disclosure__list { display: grid; gap: 0.4rem; margin: 0 0 1.25rem; }
  .disclosure__row { display: grid; grid-template-columns: 220px 1fr; gap: 1rem; padding: 0.6rem 0; border-bottom: 1px solid var(--line); }
  .disclosure__row dt { font-weight: 700; color: var(--navy-800); }
  .disclosure__row dd { margin: 0; }
  .factory-disclosure a { color: var(--brand); text-decoration: underline; }
  .factory-disclosure a:hover { color: var(--accent); }
  .tick-list { list-style: none; margin: 1rem 0 0; padding: 0; }
  .tick-list li { padding-left: 1.6rem; position: relative; margin-bottom: 0.6rem; }
  .tick-list li::before { content: "✓"; position: absolute; left: 0; color: var(--orange-500); font-weight: 700; }

  .process-list { list-style: none; margin: 0; padding: 0; counter-reset: step; max-width: 800px; }
  .process-list li { position: relative; padding: 0 0 1.5rem 3rem; counter-increment: step; }
  .process-list li::before {
    content: counter(step);
    position: absolute; left: 0; top: 0;
    width: 2rem; height: 2rem; border-radius: 50%;
    background: var(--orange-500); color: #fff; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
  }
  .process-list li::after {
    content: ""; position: absolute; left: 0.95rem; top: 2.2rem; bottom: 0;
    width: 2px; background: var(--line-strong);
  }
  .process-list li:last-child::after { display: none; }
  .process-list h3 { margin: 0 0 0.35rem; }
  .process-list p { margin: 0; color: var(--ink-soft); }

  .qc-gate { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: var(--sp-5); box-shadow: var(--shadow-sm); }
  .qc-gate__code { display: inline-block; background: var(--navy-050); color: var(--navy-700); font-weight: 700; font-size: 0.8rem; letter-spacing: 0.05em; padding: 0.2rem 0.6rem; border-radius: 999px; margin-bottom: 0.6rem; }
  .qc-gate h3 { color: var(--navy-800); font-size: 1rem; }
  .qc-gate p { margin-bottom: 0; }
  @media (max-width: 820px) { .factory { grid-template-columns: 1fr; } .disclosure__row { grid-template-columns: 1fr; gap: 0.2rem; } }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { newsPosts } from '../../data/newsPosts';
import { getNewsAnalysis } from '../../data/newsAnalysis';

export function getStaticPaths() {
  return newsPosts.map((n) => ({ params: { slug: n.slug }, props: { post: n } }));
}

const { post } = Astro.props;
const idx = newsPosts.findIndex((n) => n.slug === post.slug);
const prev = idx > 0 ? newsPosts[idx - 1] : null;
const next = idx < newsPosts.length - 1 ? newsPosts[idx + 1] : null;
const analysis = getNewsAnalysis(post.slug);

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  datePublished: post.date,
  dateModified: post.date,
  author: { '@type': 'Organization', name: site.companyName },
  publisher: { '@type': 'Organization', name: site.companyName, url: Astro.site?.toString() ?? `https://${site.domain}` },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
  description: post.body.slice(0, 155),
};

function renderBody(body: string): string {
  return body.split('\n\n').filter(Boolean).map((p) => `<p>${p}</p>`).join('');
}
---

<BaseLayout title={post.title} description={post.body.slice(0, 155)}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />

  <section class="page-hero">
    <div class="container">
      <span class="chip">{post.categoryLabel}</span>
      <h1>{post.title}</h1>
      <p>Release time: {post.date}</p>
    </div>
  </section>

  <article class="section">
    <div class="container article">
      <div class="article__body" set:html={renderBody(post.body)} />

      {post.scopeNote && (
        <aside class="scope-note">
          <strong>Reference &amp; scope.</strong>
          <p>{post.scopeNote}</p>
        </aside>
      )}

      {analysis && (
        <aside class="analysis">
          <h2>{analysis.heading}</h2>
          {analysis.paragraphs.map((p) => <p>{p}</p>)}
        </aside>
      )}

      <nav class="article__nav">
        {prev && <a href={`/news/${prev.slug}/`}>&larr; {prev.title}</a>}
        {next && <a href={`/news/${next.slug}/`}>{next.title} &rarr;</a>}
      </nav>
    </div>
  </article>
</BaseLayout>

<style>
  .page-hero .chip { margin-bottom: 0.75rem; background: var(--orange-500); color: #fff; border-color: var(--orange-600); }
  .article { max-width: 800px; }
  .article__body { font-size: 1.02rem; }
  .article__body p { margin-bottom: 1.2em; }
  .analysis {
    margin-top: 2.5rem;
    padding: var(--sp-6);
    background: var(--orange-050);
    border-left: 4px solid var(--orange-500);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .analysis h2 { color: var(--navy-800); font-size: 1.35rem; }
  .analysis p:last-child { margin-bottom: 0; }
  .scope-note {
    margin-top: 2rem;
    padding: var(--sp-5);
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  .scope-note strong { color: var(--navy-800); }
  .scope-note p { margin: 0.4rem 0 0; }
  .article__nav { display: flex; justify-content: space-between; gap: 1rem; margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--line); font-size: 0.95rem; }
  .article__nav a { max-width: 45%; }
</style>

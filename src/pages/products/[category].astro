---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { productCategories, site } from '../../data/site';
import productsData from '../../data/products.json';
import { getCategoryContent } from '../../data/categoryContent';
import { getFitment } from '../../data/vehicleFitment';

export function getStaticPaths() {
  return productCategories.map((c) => ({ params: { category: c.slug }, props: { category: c } }));
}

const { category } = Astro.props;
const products = productsData.products.filter((p) => p.category === category.slug);
const content = getCategoryContent(category.slug);
const fitment = getFitment(category.slug);
---

<BaseLayout title={category.name} description={category.desc}>
  <section class="page-hero">
    <div class="container page-hero__inner">
      <div>
        <h1>{category.name}</h1>
        <p>{category.desc}</p>
      </div>
      <img src={category.icon} alt={category.name} width="120" height="120" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>{category.name} Products</h2>
        <p class="lede">{products.length > 0 ? `${products.length} product${products.length === 1 ? '' : 's'} in this category.` : 'SKU list available on request.'}</p>
      </div>
      {
        products.length === 0 ? (
          <div class="on-request">
            <p>This product line is part of our production capability. The SKU list is available on request — tell us your target application or OE / cross-reference number and we will match the right part for you.</p>
            <a class="btn btn--primary" href="/contact/">Request the SKU list</a>
          </div>
        ) : (
          <div class="grid grid--3">
            {
              products.map((p) => (
                <a class="card product-card" href={`/products/${category.slug}/${p.slug}/`}>
                  <img src={p.image} alt={`${p.name} ${p.model}`} width="400" height="300" loading="lazy" />
                  <h3>{p.name}</h3>
                  <p class="chip">{p.model}</p>
                  <p class="muted small">{p.desc}</p>
                </a>
              ))
            }
          </div>
        )
      }
    </div>
  </section>

  {content && (
    <>
      <section class="section section--soft">
        <div class="container">
          <div class="section-head">
            <h2>Buyer's guide: sourcing {category.name.toLowerCase()}s</h2>
          </div>
          <div class="guide">
            {content.purchasingGuide.map((p) => <p>{p}</p>)}
          </div>
          <div class="opinion">
            <strong>{content.selectionAdvice.heading}</strong>
            <ul class="opinion-list">
              {content.selectionAdvice.items.map((i) => <li>{i}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="section-head">
            <h2>What you should know about {category.name.toLowerCase()}s</h2>
          </div>
          <div class="longtail">
            {content.longTail.map((p) => <p>{p}</p>)}
          </div>
        </div>
      </section>
    </>
  )}

  {fitment && (
    <section class="section section--soft">
      <div class="container">
        <div class="section-head">
          <h2>Vehicle Fitment &amp; Brand Association</h2>
          <p class="lede">{fitment.intro}</p>
        </div>
        <div class="table-wrap">
          <table class="spec fitment-table">
            <thead>
              <tr><th>Brand</th><th>Region</th><th>Common model applications</th><th>Filter note</th></tr>
            </thead>
            <tbody>
              {
                fitment.brands.map((b) => (
                  <tr>
                    <th>{b.brand}</th>
                    <td>{b.region}</td>
                    <td>
                      <ul class="inline-links">
                        {
                          b.models.map((m) => (
                            <li>{b.brand} {m} {category.name.toLowerCase()}</li>
                          ))
                        }
                      </ul>
                    </td>
                    <td class="muted small">{b.filterNote}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="muted small mt-2">
          {fitment.disclaimer} See <a href={`${site.dataSiteUrl}/fitment/${category.slug}/`} target="_blank" rel="noopener">reference fitment data ↗</a>.
        </p>
      </div>
    </section>
  )}

  {content && content.faqs.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2>Frequently Asked Questions</h2>
        </div>
        <div class="faq-list">
          {
            content.faqs.map((f) => (
              <details class="faq">
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  )}

  <section class="section section--soft">
    <div class="container center">
      <h2>Looking for a specific filter?</h2>
      <p class="lede">Tell us your OE number or vehicle application and we will match the right part.</p>
      <a class="btn btn--primary" href="/contact/">Request a Quote</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(160deg, var(--navy-900), var(--navy-700));
    color: #fff; padding: 3.5rem 0;
  }
  .page-hero__inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .page-hero h1 { color: #fff; margin-bottom: 0.4rem; }
  .page-hero p { color: var(--navy-100); margin: 0; }
  .page-hero img { max-height: 120px; width: auto; filter: drop-shadow(0 4px 10px rgba(0,0,0,0.3)); }

  .product-card { color: inherit; display: flex; flex-direction: column; gap: 0.5rem; }
  .product-card:hover { color: inherit; }
  .product-card img { width: 100%; height: 200px; object-fit: cover; border-radius: var(--radius-sm); }

  .guide { max-width: 800px; }
  .opinion-list { margin: 0.5rem 0 0; padding-left: 1.2rem; }
  .opinion-list li { margin-bottom: 0.4rem; }

  .longtail { max-width: 800px; display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: var(--sp-6); }
  .longtail p { background: #fff; border: 1px solid var(--line); border-left: 4px solid var(--orange-500); border-radius: var(--radius); padding: var(--sp-5); margin: 0; box-shadow: var(--shadow-sm); }

  .inline-links { list-style: none; margin: 0; padding: 0; }
  .inline-links li { display: inline; margin-right: 0.35rem; }
  .inline-links li::after { content: "·"; color: var(--ink-faint); margin-left: 0.35rem; }
  .inline-links li:last-child::after { content: ""; }
  .inline-links a { color: var(--ink-soft); }
  .inline-links a:hover { color: var(--orange-600); }
  .fitment-table th { white-space: normal; }

  .on-request {
    background: #fff; border: 1px solid var(--line); border-left: 4px solid var(--orange-500);
    border-radius: var(--radius); padding: var(--sp-6); max-width: 800px;
  }
  .on-request p { margin-bottom: 1rem; }

  .faq-list { max-width: 800px; }

  @media (max-width: 640px) { .page-hero__inner { flex-direction: column; align-items: flex-start; } }
</style>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { productCategories } from '../../../data/site';
import productsData from '../../../data/products.json';

export function getStaticPaths() {
  return productsData.products.map((p) => ({
    params: { category: p.category, slug: p.slug },
    props: { product: p },
  }));
}

const { product } = Astro.props;
const category = productCategories.find((c) => c.slug === product.category);
const related = productsData.products.filter((p) => p.category === product.category && p.slug !== product.slug).slice(0, 4);
---

<BaseLayout title={`${product.name} ${product.model}`} description={product.desc}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <div class="container">
      <a href="/">Home</a> <span>/</span> <a href="/products/">Products</a> <span>/</span>
      <a href={`/products/${category.slug}/`}>{category.name}</a> <span>/</span>
      <span>{product.model}</span>
    </div>
  </nav>

  <section class="section">
    <div class="container product">
      <div class="product__gallery">
        <img src={product.image} alt={`${product.name} ${product.model}`} width="640" height="480" />
        {
          product.gallery.slice(1).map((g) => (
            <img src={g} alt={`${product.name} gallery`} width="640" height="480" loading="lazy" />
          ))
        }
      </div>
      <div class="product__info">
        <span class="chip">{category.name}</span>
        <h1>{product.name}</h1>
        <p class="model">Model: <strong>{product.model}</strong></p>
        <p>{product.desc}</p>

        <table class="spec">
          <tbody>
            <tr><th>Category</th><td>{category.name}</td></tr>
            <tr><th>Model</th><td>{product.model}</td></tr>
            <tr><th>Source reference</th><td>#{product.sourceId}</td></tr>
          </tbody>
        </table>

        <p class="muted small">
          Dimensions, filtration media and efficiency are confirmed per OE application.
          Tell us your OE / cross-reference number for an exact match.
        </p>

        <div class="product__cta">
          <a class="btn btn--primary" href="/contact/">Get a Quote</a>
          <a class="btn btn--outline" href={`/products/${category.slug}/`}>View {category.name}</a>
        </div>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section section--soft">
      <div class="container">
        <div class="section-head"><h2>Related Products</h2></div>
        <div class="grid grid--4">
          {
            related.map((r) => (
              <a class="card related" href={`/products/${r.category}/${r.slug}/`}>
                <img src={r.image} alt={`${r.name} ${r.model}`} width="300" height="200" loading="lazy" />
                <h3>{r.name}</h3>
                <p class="chip">{r.model}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .crumbs { background: var(--bg-soft); padding: 0.8rem 0; font-size: 0.9rem; color: var(--ink-soft); }
  .crumbs .container { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .product { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: start; }
  .product__gallery img { width: 100%; border-radius: var(--radius); box-shadow: var(--shadow-sm); margin-bottom: 1rem; }
  .product__info h1 { margin: 0.5rem 0 0.25rem; }
  .product__info .model { color: var(--ink-soft); margin-bottom: 1rem; }
  .product__cta { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 1.5rem; }
  table.spec { margin-top: 1.25rem; }
  .related { color: inherit; display: flex; flex-direction: column; gap: 0.4rem; }
  .related:hover { color: inherit; }
  .related img { width: 100%; height: 150px; object-fit: cover; border-radius: var(--radius-sm); }
  @media (max-width: 820px) { .product { grid-template-columns: 1fr; } }
</style>

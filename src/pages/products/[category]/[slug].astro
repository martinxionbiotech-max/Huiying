---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { productCategories, site } from '../../../data/site';
import productsData from '../../../data/products.json';
import { getProductContent } from '../../../data/productContent';
import { NOINDEX_SET } from '../../../data/indexQuality.mjs';

export function getStaticPaths() {
  return productsData.products.map((p) => ({
    params: { category: p.category, slug: p.slug },
    props: { product: p },
  }));
}

const { product } = Astro.props;
// index-quality batch: not-ready SKU pages get a robots noindex (still crawlable,
// still live and internally linked — only excluded from search indexing + sitemap).
const noindex = NOINDEX_SET.has(product.slug);
// Per-SKU original editorial content (quality pass 2) — SKU-level independent info
// that enriches the thin B-tier pages while the evidence fields above stay conditional.
const editorial = getProductContent(product.slug);
const category = productCategories.find((c) => c.slug === product.category);
const related = productsData.products.filter((p) => p.category === product.category && p.slug !== product.slug).slice(0, 4);
const sourceStatus = (product.source && product.source.status) ? product.source.status : null;
const sourceName = (product.source && product.source.name) ? product.source.name : null;
const sourceUrl = (product.source && product.source.url) ? product.source.url : null;
const sourceRetrieved = (product.source && product.source.retrieved) ? product.source.retrieved : null;

const siteUrl = Astro.site?.toString() ?? 'https://carfilterspro.com';
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();

// Direct mailto RFQ (no server-side form on this static site).
const rfqSubject = `RFQ ${product.model}`;
const rfqBody = [
  `Model: ${product.model}`,
  `Product URL: ${pageUrl}`,
  '',
  'OE / cross-reference number:',
  'Target quantity:',
  'Destination market:',
  'Packaging / private-label requirements:',
].join('\n');
const rfqMailto = `mailto:${site.email}?subject=${encodeURIComponent(rfqSubject)}&body=${encodeURIComponent(rfqBody)}`;

// ---------------------------------------------------------------------------
// Evidence section — "What we can confirm" is built ONLY from source-published
// data present on the record. Nothing is invented; absent fields are simply not
// listed (instead they surface in "What you should provide").
// ---------------------------------------------------------------------------
const confirmed: { label: string; value: string }[] = [];
if (product.oeNumbers && product.oeNumbers.length > 0) {
  confirmed.push({ label: 'OE number', value: product.oeNumbers.join(' / ') });
}
if (product.crossReference) {
  confirmed.push({ label: 'Cross-reference', value: product.crossReference });
}
if (product.material) {
  confirmed.push({ label: 'Material', value: product.material });
}
if (product.dimensions) {
  confirmed.push({ label: 'Dimensions', value: product.dimensions });
}
if (product.fitment && product.fitment.brand) {
  const models = product.fitment.models?.length ? ` — ${product.fitment.models.join(', ')}` : '';
  confirmed.push({ label: 'Brand fitment (source)', value: `${product.fitment.brand}${models}` });
}

const provideItems: string[] = [
  'Your OE / cross-reference number — so we confirm the exact match',
  'Target quantity and destination market',
  'Packaging / private-label requirements (neutral, custom or your own brand)',
];
if (!product.dimensions) {
  provideItems.push('Exact dimensions, if your application needs a size the source catalogue does not publish');
}
if (!(product.fitment && product.fitment.brand)) {
  provideItems.push('Vehicle application, so we can confirm fitment against your OE table');
}

const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${product.name} ${product.model}`,
  sku: product.model,
  mpn: product.model,
  brand: { '@type': 'Brand', name: site.brand },
  image: new URL(product.image, Astro.site).toString(),
  description: product.desc,
  category: category?.name ?? product.category,
  url: pageUrl,
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Products', item: `${siteUrl}/products/` },
    { '@type': 'ListItem', position: 3, name: category?.name ?? product.category, item: `${siteUrl}/products/${product.category}/` },
    { '@type': 'ListItem', position: 4, name: product.model },
  ],
};
---

<BaseLayout title={`${product.name} ${product.model}`} description={product.desc} noindex={noindex}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <nav class="crumbs" aria-label="Breadcrumb">
    <div class="container">
      <a href="/">Home</a> <span>/</span> <a href="/products/">Products</a> <span>/</span>
      <a href={`/products/${category.slug}/`}>{category.name}</a> <span>/</span>
      <span>{product.model}</span>
    </div>
  </nav>

  <section class="section">
    <div class="container product">
      <div class="product__gallery">
        <img src={product.image} alt={`${product.model} ${category.name.toLowerCase()}`} width="640" height="480" />
        {
          product.gallery.slice(1).map((g, i) => (
            <img src={g} alt={`${product.model} ${category.name.toLowerCase()} — view ${i + 1}`} width="640" height="480" loading="lazy" />
          ))
        }
      </div>
      <div class="product__info">
        <span class="chip">{category.name}</span>
        <h1>{product.name} <span class="model-inline">{product.model}</span></h1>
        <p class="lede">{product.desc}</p>

        <table class="spec">
          <tbody>
            <tr><th>Category</th><td>{category.name}</td></tr>
            <tr><th>Model</th><td>{product.model}</td></tr>
            {product.oeNumbers && product.oeNumbers.length > 0 && <tr><th>OE number</th><td>{product.oeNumbers.join(' / ')}</td></tr>}
            {product.crossReference && <tr><th>Cross-reference</th><td>{product.crossReference}</td></tr>}
            {product.material && <tr><th>Material</th><td>{product.material}</td></tr>}
            {product.fitment && product.fitment.brand && <tr><th>Brand fitment</th><td>{product.fitment.brand}{product.fitment.models?.length ? ' ' + product.fitment.models.join(', ') : ''}</td></tr>}
            <tr><th>Brand</th><td>{site.brand}</td></tr>
            <tr><th>Source reference</th><td>#{product.sourceId}</td></tr>
          </tbody>
        </table>

        <div class="product__cta">
          <a class="btn btn--primary" href={rfqMailto}>Request a quote</a>
          <a class="btn btn--outline" href={`/products/${category.slug}/`}>View {category.name}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <h2>Specification &amp; evidence</h2>
        <p class="lede">
          What the source catalogue confirms for {product.model}, and what we ask you to provide
          to finalise an exact match.
        </p>
      </div>

      <div class="evidence-grid">
        <div class="deep-block">
          <h3>What we can confirm</h3>
          {
            confirmed.length > 0 ? (
              <div class="table-wrap">
                <table class="spec spec--ordering">
                  <tbody>
                    {confirmed.map((row) => (
                      <tr><th>{row.label}</th><td>{row.value}</td></tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : (
              <p class="muted small">
                No source-verified specification fields are published for this SKU. Request the
                details below from us before quoting.
              </p>
            )
          }
          <p class="muted small mt-2">
            {
              sourceName && (
                <span>
                  Source: {sourceName}
                  {sourceStatus ? ` · status ${sourceStatus}` : ''}
                  {sourceRetrieved ? ` · retrieved ${sourceRetrieved}` : ''}
                  {sourceUrl && <a href={sourceUrl} rel="noopener" target="_blank"> (view source)</a>}.
                </span>
              )
            }
            OE numbers, cross-references, material and brand fitment are as published by the
            source catalogue — they are not an independent verification.
          </p>
        </div>

        <div class="deep-block">
          <h3>What you should provide</h3>
          <ul>
            {provideItems.map((i) => <li>{i}</li>)}
          </ul>
          <p class="muted small mt-2">
            Final pricing depends on model, quantity, specification and shipping terms.
          </p>
        </div>
      </div>
    </div>
  </section>

  {editorial && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <h2>Product &amp; sourcing notes</h2>
          <p class="lede">
            Independent editorial notes for {product.model} — application, structure and
            procurement guidance written per SKU.
          </p>
        </div>

        <div class="editorial">
          {editorial.application.length > 0 && (
            <div class="editorial__block">
              <h3>Application</h3>
              {editorial.application.map((p) => <p>{p}</p>)}
            </div>
          )}

          {editorial.scenarios.length > 0 && (
            <div class="editorial__block">
              <h3>Where it is used</h3>
              <ul>{editorial.scenarios.map((s) => <li>{s}</li>)}</ul>
            </div>
          )}

          {editorial.technical.length > 0 && (
            <div class="editorial__block">
              <h3>What to check</h3>
              <ul>{editorial.technical.map((t) => <li>{t}</li>)}</ul>
            </div>
          )}

          {editorial.procurement.length > 0 && (
            <div class="editorial__block">
              <h3>Sourcing notes</h3>
              {editorial.procurement.map((p) => <p>{p}</p>)}
            </div>
          )}

          <div class="editorial__grid">
            {editorial.selectionNotes.length > 0 && (
              <div class="editorial__block">
                <h3>Selection notes</h3>
                <ul>{editorial.selectionNotes.map((s) => <li>{s}</li>)}</ul>
              </div>
            )}
            {editorial.maintenance.length > 0 && (
              <div class="editorial__block">
                <h3>Maintenance</h3>
                <ul>{editorial.maintenance.map((m) => <li>{m}</li>)}</ul>
              </div>
            )}
          </div>

          {editorial.buyerNote && (
            <div class="buyer-note">
              <strong>Buyer note</strong>
              <p>{editorial.buyerNote}</p>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container center">
      <div class="section-head">
        <h2>Fitment reference</h2>
        <p class="lede">
          We do not publish an unverified multi-brand vehicle list for this SKU. For the reference
          vehicle framework that backs our fitment work, see the data site.
        </p>
      </div>
      <a class="btn btn--outline" href={`${site.dataSiteUrl}/fitment/${category.slug}/`} target="_blank" rel="noopener">
        Reference fitment data ↗
      </a>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section section--soft">
      <div class="container">
        <div class="section-head"><h2>Related Products</h2></div>
        <div class="grid grid--4">
          {
            related.map((r) => (
              <a class="card related" href={`/products/${r.category}/${r.slug}/`}>
                <img src={r.image} alt={`${r.model} ${category.name.toLowerCase()}`} width="300" height="200" loading="lazy" />
                <h3>{r.name}</h3>
                <p class="chip">{r.model}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .crumbs { background: var(--bg-soft); padding: 0.8rem 0; font-size: 0.9rem; color: var(--ink-soft); }
  .crumbs .container { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .product { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: start; }
  .product__gallery img { width: 100%; border-radius: var(--radius); box-shadow: var(--shadow-sm); margin-bottom: 1rem; }
  .product__info h1 { margin: 0.5rem 0 0.5rem; }
  .model-inline { color: var(--orange-600); font-size: 0.85em; white-space: nowrap; }
  .product__info .lede { margin-bottom: 1.25rem; }
  .product__cta { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 1.5rem; }
  table.spec { margin-top: 1.25rem; }

  .evidence-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-6); align-items: start; }
  .deep-block { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: var(--sp-6); box-shadow: var(--shadow-sm); }
  .deep-block h3 { color: var(--navy-800); }
  .deep-block ul { margin: 0; padding-left: 1.2rem; }
  .deep-block li { margin-bottom: 0.5rem; }

  .editorial { max-width: 900px; display: grid; gap: var(--sp-6); }
  .editorial__block { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: var(--sp-6); box-shadow: var(--shadow-sm); }
  .editorial__block h3 { color: var(--navy-800); }
  .editorial__block ul { margin: 0; padding-left: 1.2rem; }
  .editorial__block li { margin-bottom: 0.5rem; }
  .editorial__block p { margin-bottom: 0.75rem; }
  .editorial__block p:last-child { margin-bottom: 0; }
  .editorial__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-6); }
  @media (max-width: 700px) { .editorial__grid { grid-template-columns: 1fr; } }
  .buyer-note { background: var(--bg-soft); border-left: 4px solid var(--orange-500); border-radius: var(--radius); padding: var(--sp-6); }
  .buyer-note strong { color: var(--navy-800); display: block; margin-bottom: 0.4rem; }
  .buyer-note p { margin: 0; }

  .spec--ordering th { width: 220px; }

  .related { color: inherit; display: flex; flex-direction: column; gap: 0.4rem; }
  .related:hover { color: inherit; }
  .related img { width: 100%; height: 150px; object-fit: cover; border-radius: var(--radius-sm); }
  @media (max-width: 820px) {
    .product { grid-template-columns: 1fr; }
    .evidence-grid { grid-template-columns: 1fr; }
  }
</style>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { productCategories, site } from '../../../data/site';
import productsData from '../../../data/products.json';
import { getProductContent } from '../../../data/productContent';
import { NOINDEX_SET } from '../../../data/indexQuality.mjs';

export function getStaticPaths() {
  return productsData.products.map((p) => ({
    params: { category: p.category, slug: p.slug },
    props: { product: p },
  }));
}

const { product } = Astro.props;
// index-quality batch: not-ready SKU pages get a robots noindex (still crawlable,
// still live and internally linked — only excluded from search indexing + sitemap).
const noindex = NOINDEX_SET.has(product.slug);
// Per-SKU original editorial content — evidence-graded and de-templated.
const editorial = getProductContent(product.slug);
const category = productCategories.find((c) => c.slug === product.category);
const related = productsData.products.filter((p) => p.category === product.category && p.slug !== product.slug).slice(0, 4);

const sourceName = (product.source && product.source.name) ? product.source.name : null;
const sourceUrl = (product.source && product.source.url) ? product.source.url : null;
const sourceRetrieved = (product.source && product.source.retrieved) ? product.source.retrieved : null;
// Source provenance → three-state label: congben (source-verified) = catalog-confirmed; tianrui = reference.
const sourceStatus = (product.source && product.source.status === 'source-verified') ? 'catalog-confirmed' : 'reference';

const siteUrl = Astro.site?.toString() ?? 'https://carfilterspro.com';
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();

// Direct mailto RFQ (no server-side form on this static site).
const rfqSubject = `RFQ ${product.model}`;
const rfqBody = [
  `Model: ${product.model}`,
  `Product URL: ${pageUrl}`,
  '',
  'OE / cross-reference number:',
  'Target quantity:',
  'Destination market:',
  'Packaging / private-label requirements:',
].join('\n');
const rfqMailto = `mailto:${site.email}?subject=${encodeURIComponent(rfqSubject)}&body=${encodeURIComponent(rfqBody)}`;

// ---------------------------------------------------------------------------
// Three-state data status model (audit4 / P0):
//   catalog-confirmed — source-catalog field (OE / cross-reference / material);
//                       OE↔brand attribution is a source-catalog fact.
//   factory-verified   — factory drawing / measurement (none today).
//   pending            — year / engine / thread / seal / bypass not yet verified.
// Nothing is invented; absent fields are rendered `pending` and never guessed.
// ---------------------------------------------------------------------------
const oeNumbers = product.oeNumbers && product.oeNumbers.length > 0 ? product.oeNumbers : null;
const crossReference = product.crossReference || null;
const material = product.material || null;
const dimensions = product.dimensions || null;
const fitment = product.fitment || null;
const fitBrand = fitment && fitment.brand ? fitment.brand : null;
const fitModels = fitment && Array.isArray(fitment.models) && fitment.models.length > 0 ? fitment.models : null;
const fitEngine = fitment && fitment.engine ? fitment.engine : null;

const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${product.name} ${product.model}`,
  sku: product.model,
  mpn: product.model,
  brand: { '@type': 'Brand', name: site.brand },
  image: new URL(product.image, Astro.site).toString(),
  description: product.desc,
  category: category?.name ?? product.category,
  url: pageUrl,
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Products', item: `${siteUrl}/products/` },
    { '@type': 'ListItem', position: 3, name: category?.name ?? product.category, item: `${siteUrl}/products/${product.category}/` },
    { '@type': 'ListItem', position: 4, name: product.model },
  ],
};

const ogTitle = `${product.name} ${product.model}`;
const ogDescription = product.desc;
const ogImage = product.image;
---

<BaseLayout
  title={`${product.name} ${product.model}`}
  description={product.desc}
  noindex={noindex}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImage={ogImage}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <nav class="crumbs" aria-label="Breadcrumb">
    <div class="container">
      <a href="/">Home</a> <span>/</span> <a href="/products/">Products</a> <span>/</span>
      <a href={`/products/${category.slug}/`}>{category.name}</a> <span>/</span>
      <span>{product.model}</span>
    </div>
  </nav>

  <!-- 1. Product identity & purchase entry -->
  <section class="section">
    <div class="container product">
      <div class="product__gallery">
        <img src={product.image} alt={`${product.model} ${category.name.toLowerCase()}`} width="640" height="480" />
        {
          product.gallery.slice(1).map((g, i) => (
            <img src={g} alt={`${product.model} ${category.name.toLowerCase()} — view ${i + 1}`} width="640" height="480" loading="lazy" />
          ))
        }
      </div>
      <div class="product__info">
        <span class="chip">{category.name}</span>
        <h1>{product.name} <span class="model-inline">{product.model}</span></h1>
        <p class="lede">{product.desc}</p>

        <table class="spec">
          <tbody>
            <tr><th>Model / SKU</th><td>{product.model}</td></tr>
            <tr><th>Category</th><td>{category.name}</td></tr>
            {oeNumbers && <tr><th>OE number(s)</th><td>{oeNumbers.join(' / ')} <span class="status status--ok">catalog-confirmed</span></td></tr>}
            <tr><th>Source status</th><td>{sourceName ?? '—'} · <span class="status">{sourceStatus}</span></td></tr>
          </tbody>
        </table>

        <div class="product__cta">
          <a class="btn btn--primary" href={rfqMailto}>Request a quote</a>
          <a class="btn btn--outline" href={`/products/${category.slug}/`}>View {category.name}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Core technical parameters (only confirmed fields; unknown = pending) -->
  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <h2>Core technical parameters</h2>
        <p class="lede">
          Only fields the source catalogue publishes are shown. Thread, seal, bypass and
          filtration efficiency are <span class="status">pending</span> until Huiying confirms
          them per order.
        </p>
      </div>

      <div class="evidence-grid">
        <div class="deep-block">
          <h3>Confirmed (catalog)</h3>
          <div class="table-wrap">
            <table class="spec spec--ordering">
              <tbody>
                {oeNumbers && <tr><th>OE number(s)</th><td>{oeNumbers.join(' / ')} <span class="status status--ok">catalog-confirmed</span></td></tr>}
                {crossReference && <tr><th>Cross-reference</th><td>{crossReference} <span class="status status--ok">catalog-confirmed</span></td></tr>}
                {material && <tr><th>Material</th><td>{material} <span class="status status--ok">catalog-confirmed</span></td></tr>}
                {dimensions && <tr><th>Dimensions</th><td>{dimensions} <span class="status status--ok">catalog-confirmed</span></td></tr>}
                {!oeNumbers && !crossReference && !material && !dimensions && (
                  <tr><td colspan="2" class="muted small">No source-published specification fields for this SKU.</td></tr>
                )}
              </tbody>
            </table>
          </div>
        </div>

        <div class="deep-block">
          <h3>Pending (unverified)</h3>
          <div class="table-wrap">
            <table class="spec spec--ordering">
              <tbody>
                <tr><th>Thread / seal</th><td><span class="status">pending</span></td></tr>
                <tr><th>Bypass calibration</th><td><span class="status">pending</span></td></tr>
                <tr><th>Filtration efficiency</th><td><span class="status">pending</span></td></tr>
                <tr><th>Dimensions</th><td>{dimensions ?? <span class="status">pending</span>}</td></tr>
              </tbody>
            </table>
          </div>
          <p class="muted small mt-2">Request these values from sales before quoting.</p>
        </div>
      </div>

      {editorial && editorial.technical.length > 0 && (
        <div class="deep-block mt-2">
          <h3>Structure &amp; category knowledge</h3>
          <ul>{editorial.technical.map((t) => <li>{t}</li>)}</ul>
        </div>
      )}
    </div>
  </section>

  <!-- 3. Fitment & cross-reference (reference vs confirmed; no auto-inference) -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Fitment &amp; cross-reference</h2>
        <p class="lede">
          OE↔brand attribution is a source-catalogue fact (<span class="status status--ok">catalog-confirmed</span>);
          vehicle model / year / engine is <span class="status">reference</span> — never a precise fitment claim.
        </p>
      </div>

      <div class="evidence-grid">
        <div class="deep-block">
          <h3>Brand fitment (OE↔brand)</h3>
          {fitBrand ? (
            <p><strong>{fitBrand}</strong> <span class="status status--ok">catalog-confirmed</span></p>
          ) : (
            <p class="muted small">No brand stated by the source catalogue for this OE number.</p>
          )}
          <h3 class="mt-2">Cross-reference</h3>
          {crossReference ? (
            <p>{crossReference} <span class="status status--ok">catalog-confirmed</span> — as published by the source catalogue.</p>
          ) : (
            <p class="muted small">No competitor cross-reference published.</p>
          )}
        </div>
        <div class="deep-block">
          <h3>Vehicle / engine (reference)</h3>
          {fitModels ? (
            <p>{fitModels.join(', ')} <span class="status">reference</span></p>
          ) : (
            <p class="muted small">No specific vehicle models published — confirm against your OE table.</p>
          )}
          {fitEngine && <p>{fitEngine} <span class="status">reference</span></p>}
          <p class="muted small mt-2">
            We do not infer compatibility from a similar OE number or an engine displacement
            range. Vehicle model and year are reference-only until confirmed.
          </p>
        </div>
      </div>

      {editorial && (editorial.application.length > 0 || editorial.scenarios.length > 0) && (
        <div class="deep-block mt-2">
          {editorial.application.length > 0 && (
            <>
              <h3>Application</h3>
              {editorial.application.map((p) => <p>{p}</p>)}
            </>
          )}
          {editorial.scenarios.length > 0 && (
            <>
              <h3 class="mt-2">Where it is used</h3>
              <ul>{editorial.scenarios.map((s) => <li>{s}</li>)}</ul>
            </>
          )}
        </div>
      )}

      <p class="center mt-2">
        <a class="btn btn--outline" href={`${site.dataSiteUrl}/fitment/${category.slug}/`} target="_blank" rel="noopener">
          Reference fitment data ↗
        </a>
      </p>
    </div>
  </section>

  <!-- 4. Quality verification & documents (only real items; none today) -->
  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <h2>Quality verification &amp; documents</h2>
        <p class="lede">What is actually published for {product.model}, and what to request.</p>
      </div>
      <div class="deep-block">
        <p class="muted">
          No published test data for this SKU — request inspection/test documents from sales
          before quoting. No verification date is claimed.
        </p>
        <div class="table-wrap">
          <table class="spec spec--ordering">
            <tbody>
              <tr><th>Inspection / test report</th><td><span class="status">pending</span></td></tr>
              <tr><th>Verification date</th><td><span class="status">pending</span></td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. OEM / private-label procurement -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>OEM &amp; private-label procurement</h2>
        <p class="lede">Packaging, labelling, MOQ, sampling, mixed-batch and lead time are finalised per order.</p>
      </div>
      <div class="evidence-grid">
        <div class="deep-block">
          <h3>Order conditions (confirm per order)</h3>
          <ul class="tick-list">
            <li>Packaging &amp; labelling — neutral, custom or your own brand</li>
            <li>MOQ — confirmed per order specification</li>
            <li>Sampling — available on request</li>
            <li>Mixed-batch / multi-SKU orders — supported</li>
            <li>Lead time — confirmed per order</li>
          </ul>
        </div>
        <div class="deep-block">
          {editorial && editorial.procurement.length > 0 && (
            <>
              <h3>Sourcing notes</h3>
              {editorial.procurement.map((p) => <p>{p}</p>)}
            </>
          )}
          {editorial && editorial.selectionNotes.length > 0 && (
            <>
              <h3 class="mt-2">Selection notes</h3>
              <ul>{editorial.selectionNotes.map((s) => <li>{s}</li>)}</ul>
            </>
          )}
          {editorial && editorial.buyerNote && (
            <div class="buyer-note mt-2">
              <strong>Buyer note</strong>
              <p>{editorial.buyerNote}</p>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Related products & technical materials -->
  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <h2>Related products &amp; technical materials</h2>
      </div>

      <div class="evidence-grid">
        <div class="deep-block">
          <h3>This SKU's data record</h3>
          <ul>
            <li><a href={`${site.dataSiteUrl}/products/${product.model}/`} target="_blank" rel="noopener">Structured SKU record (data site) ↗</a></li>
            <li><a href={`/products/${category.slug}/`}>{category.name} category page</a></li>
            <li><a href={`/guides/`}>Buying &amp; quality guides</a></li>
          </ul>
          {editorial && editorial.maintenance.length > 0 && (
            <>
              <h3 class="mt-2">Maintenance</h3>
              <ul>{editorial.maintenance.map((m) => <li>{m}</li>)}</ul>
            </>
          )}
        </div>
        <div class="deep-block">
          <h3>Related SKUs</h3>
          {related.length > 0 ? (
            <ul>
              {related.map((r) => (
                <li><a href={`/products/${r.category}/${r.slug}/`}>{r.name} <span class="muted small">({r.model})</span></a></li>
              ))}
            </ul>
          ) : (
            <p class="muted small">No other SKUs in this category yet.</p>
          )}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .crumbs { background: var(--bg-soft); padding: 0.8rem 0; font-size: 0.9rem; color: var(--ink-soft); }
  .crumbs .container { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .product { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: start; }
  .product__gallery img { width: 100%; border-radius: var(--radius); box-shadow: var(--shadow-sm); margin-bottom: 1rem; }
  .product__info h1 { margin: 0.5rem 0 0.5rem; }
  .model-inline { color: var(--orange-600); font-size: 0.85em; white-space: nowrap; }
  .product__info .lede { margin-bottom: 1.25rem; }
  .product__cta { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 1.5rem; }
  table.spec { margin-top: 1.25rem; }

  .status { display: inline-block; font-size: 0.78rem; font-weight: 600; color: var(--ink-soft); background: var(--bg-soft); border-radius: 999px; padding: 0.15rem 0.55rem; }
  .status--ok { color: var(--navy-700); background: var(--navy-050); }

  .evidence-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-6); align-items: start; }
  .deep-block { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: var(--sp-6); box-shadow: var(--shadow-sm); }
  .deep-block h3 { color: var(--navy-800); }
  .deep-block ul { margin: 0; padding-left: 1.2rem; }
  .deep-block li { margin-bottom: 0.5rem; }
  .deep-block p { margin-bottom: 0.75rem; }
  .deep-block p:last-child { margin-bottom: 0; }

  .spec--ordering th { width: 220px; }

  .tick-list { list-style: none; margin: 0; padding: 0; }
  .tick-list li { padding-left: 1.6rem; position: relative; margin-bottom: 0.6rem; }
  .tick-list li::before { content: "✓"; position: absolute; left: 0; color: var(--orange-500); font-weight: 700; }

  .buyer-note { background: var(--bg-soft); border-left: 4px solid var(--orange-500); border-radius: var(--radius); padding: var(--sp-6); }
  .buyer-note strong { color: var(--navy-800); display: block; margin-bottom: 0.4rem; }
  .buyer-note p { margin: 0; }

  .mt-2 { margin-top: 1.25rem; }
  .muted { color: var(--ink-soft); }
  .small { font-size: 0.9rem; }

  @media (max-width: 820px) {
    .product { grid-template-columns: 1fr; }
    .evidence-grid { grid-template-columns: 1fr; }
  }
</style>

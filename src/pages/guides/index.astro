---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { guidesPosts, type Guide } from '../../data/guidesPosts';

// Three pillar groups (source briefs: selection, quality & testing, OEM sourcing).
interface PillarGroup {
  name: string;
  blurb: string;
  pillarSlug: string;
  clusterSlugs: string[];
}

const groups: PillarGroup[] = [
  {
    name: 'Selection',
    blurb: 'Choose the right filter type and verify application before you buy.',
    pillarSlug: 'automotive-filter-selection-guide',
    clusterSlugs: [
      'air-filter-vs-cabin-air-filter',
      'how-to-choose-an-oil-filter',
      'automotive-fuel-filter-types',
      'replacement-filter-by-oe-number',
    ],
  },
  {
    name: 'Quality & Testing',
    blurb: 'Evaluate performance, read test reports, and inspect before you approve.',
    pillarSlug: 'automotive-filter-quality-testing',
    clusterSlugs: [
      'automotive-air-filter-efficiency-test',
      'oil-filter-multi-pass-test',
      'filter-media-pressure-drop-dust-holding-capacity',
      'automotive-filter-quality-inspection',
    ],
  },
  {
    name: 'OEM Sourcing',
    blurb: 'Source, evaluate manufacturers, and plan sample-to-production shipping.',
    pillarSlug: 'oem-automotive-filter-sourcing',
    clusterSlugs: [
      'how-to-evaluate-automotive-filter-manufacturer',
      'oem-automotive-filter-sourcing-from-sample-to-production',
      'automotive-filter-packaging-container-loading',
    ],
  },
];

const bySlug = new Map<string, Guide>(guidesPosts.map((g) => [g.slug, g]));
---

<BaseLayout title="Buying Guides" description="Automotive filter buying guides for importers and wholesalers — selection, quality and testing, and OEM sourcing.">
  <section class="page-hero">
    <div class="container">
      <h1>Buying Guides</h1>
      <p>Practical guidance for selecting, verifying, and sourcing automotive filters before you buy.</p>
    </div>
  </section>

  {
    groups.map((group, idx) => {
      const pillar = bySlug.get(group.pillarSlug);
      const clusters = group.clusterSlugs
        .map((slug) => bySlug.get(slug))
        .filter((g): g is Guide => Boolean(g));

      if (!pillar) return null;

      return (
        <section class={`section${idx > 0 ? ' section--top' : ''}`}>
          <div class="container">
            <div class="section-head">
              <h2>{group.name}</h2>
              <p class="lede">{group.blurb}</p>
            </div>

            <div class="pillar card">
              <span class="chip">Pillar</span>
              <h3>{pillar.title}</h3>
              <p class="lede">{pillar.description}</p>
              <a class="btn btn--primary" href={`/guides/${pillar.slug}/`}>Read the guide</a>
            </div>

            <div class="grid grid--2 cluster-grid">
              {
                clusters.map((c) => (
                  <a class="card cluster" href={`/guides/${c.slug}/`}>
                    <h4>{c.title}</h4>
                    <p class="muted small">{c.description}</p>
                    <span class="cluster__more">Read guide &rarr;</span>
                  </a>
                ))
              }
            </div>
          </div>
        </section>
      );
    })
  }
</BaseLayout>

<style>
  .page-hero {
    background: linear-gradient(160deg, var(--navy-900), var(--navy-700));
    color: #fff; padding: 3.5rem 0;
  }
  .page-hero h1 { color: #fff; margin-bottom: 0.4rem; }
  .page-hero p { color: var(--navy-100); margin: 0; }

  .section--top { padding-top: var(--sp-10); }

  .section-head h2 { font-size: clamp(1.5rem, 3vw, 1.9rem); }
  .section-head .lede { color: var(--ink-soft); }

  .pillar {
    max-width: 820px; margin: 1.25rem 0 var(--sp-8);
    border-left: 4px solid var(--orange-500);
  }
  .pillar .chip { margin-bottom: 0.75rem; background: var(--orange-500); color: #fff; border-color: var(--orange-600); }
  .pillar h3 { font-size: clamp(1.3rem, 2.5vw, 1.6rem); }

  .cluster-grid { align-items: stretch; }
  .cluster { color: inherit; display: flex; flex-direction: column; gap: 0.5rem; }
  .cluster:hover { color: inherit; }
  .cluster h4 { font-size: 1.08rem; }
  .cluster__more { color: var(--orange-600); font-weight: 600; font-size: 0.92rem; margin-top: auto; }
</style>

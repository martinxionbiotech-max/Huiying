---
import BaseLayout from '../layouts/BaseLayout.astro';
import { marketingInfo, exportMarkets, industryBackground } from '../data/company';
---

<BaseLayout title="Marketing" description="Huiying's export marketing network and private-label/OEM supply programs for buyers across Asia, the Middle East, Africa, South America and Europe.">
  <section class="page-hero">
    <div class="container"><h1>Marketing</h1><p>{marketingInfo.heading}</p></div>
  </section>

  <section class="section">
    <div class="container marketing">
      <img src={marketingInfo.image} alt={marketingInfo.imageAlt} width="560" height="420" loading="lazy" />
      <div>
        <h2>{marketingInfo.heading}</h2>
        <p>{marketingInfo.text}</p>
        <a class="btn btn--primary" href="/contact/">Contact Our Sales Team</a>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <h2>{exportMarkets.heading}</h2>
        <p class="lede">{exportMarkets.text}</p>
      </div>
      <div class="grid grid--4">
        {exportMarkets.points.map((p) => (
          <div class="card mini"><h3>{p}</h3></div>
        ))}
      </div>
      <p class="muted small mt-2">{industryBackground.paragraphs[2]}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .marketing { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 3rem; align-items: center; }
  .marketing img { border-radius: var(--radius); box-shadow: var(--shadow-md); }
  .card.mini h3 { font-size: 1rem; margin: 0; }
  @media (max-width: 820px) { .marketing { grid-template-columns: 1fr; } }
</style>

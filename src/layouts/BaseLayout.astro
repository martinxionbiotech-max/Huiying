---
// BaseLayout — shared shell (head, header, footer)
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

const fullTitle = `${title} | ${site.brand} — ${site.tagline}`;
const metaDescription =
  description ||
  `${site.brand} is a professional manufacturer of high-tech filters (air, cabin, oil, fuel filters and wipers), integrating R&D, production and sales.`;

const siteUrl = Astro.site?.toString() ?? 'https://huiyingfilter.com';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/images/8a59f159-d12a-4726-84f0-697566eec219.jpg', Astro.site).toString();

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: site.companyName,
  alternateName: [site.brand, site.companyNameShort],
  url: siteUrl,
  logo: ogImage,
  foundingDate: `${site.since}`,
  telephone: site.phone,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'CN',
    addressRegion: '河北省',
    addressLocality: '邢台市清河县',
    streetAddress: 'Wangshuangmiao Industrial Zone',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    email: site.email,
    telephone: site.phone,
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="generator" content={Astro.generator} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : null}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
